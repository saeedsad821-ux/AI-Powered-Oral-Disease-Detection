{
  "model": "EfficientNetB0",
  "weights": "imagenet",
  "input_shape": [
    224,
    224,
    3
  ],
  "batch_size": 32,
  "seed": 42,
  "optimizer": "adam",
  "loss": "sparse_categorical_crossentropy",
  "metrics": [
    "accuracy",
    "precision",
    "recall"
  ],
  "dropout_rate": 0.3,
  "class_weights": {
    "0": 1.583,
    "1": 0.7893,
    "2": 0.8738,
    "3": 0.7318,
    "4": 1.0187,
    "5": 1.6427
  },
  "stage_1_feature_extraction": {
    "backbone": "frozen",
    "learning_rate": 0.001,
    "max_epochs": 12,
    "early_stopping_patience": 4,
    "reduce_lr_patience": 2,
    "reduce_lr_factor": 0.5,
    "reduce_lr_min": 1e-06,
    "monitor": "val_loss"
  },
  "stage_2_fine_tuning": {
    "backbone": "unfrozen from 'block6a'",
    "learning_rate": 0.0001,
    "max_epochs": 10,
    "early_stopping_patience": 3,
    "reduce_lr_patience": 2,
    "reduce_lr_factor": 0.5,
    "reduce_lr_min": 1e-06,
    "monitor": "val_loss"
  },
  "callbacks": [
    "EarlyStopping",
    "ReduceLROnPlateau",
    "ModelCheckpoint",
    "CSVLogger"
  ]
}